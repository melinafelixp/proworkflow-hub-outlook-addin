# Copy this file to .env and fill in the value. Neither value is a secret.

# Application (client) ID of the Microsoft Entra app registration (docs/SETUP.md, Part A).
PWH_CLIENT_ID=

# Who may sign in.
#   https://login.microsoftonline.com/organizations   any work account (multi-tenant registration)
#   https://login.microsoftonline.com/<tenant-id>     one tenant only
PWH_AUTHORITY=https://login.microsoftonline.com/organizations
